# Synced AKMS Claude assets (produced by scripts/sync_akms_claude_assets.py at
# sidecar build time from the installed akms package; see packaging/akms_claude_assets.toml).
# The manifest + source repo are authoritative; this tree is regenerated.
services/logic_loom_api/src/logic_loom_api/resources/akms_claude/

# Synced established nodes (produced by scripts/sync_akms_nodes.py at
# sidecar build time from verified_nodes/; see PROVENANCE.toml).
# verified_nodes/ is authoritative; this tree is regenerated at build time.
services/logic_loom_api/src/logic_loom_api/resources/akms_nodes/

# Claude Code harness async-subagent worktrees (per-agent isolated copies).
.claude/worktrees/
.gitnexus

# Orchestra local tool state (session ledger + scratch diff). Machine-local and
# rewritten on every session, so it left the tree permanently dirty.
/.orchestra/

# MkDocs output (mkdocs build)
/site/
